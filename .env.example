# AMD Token Factory (https://notebooks.amd.com/tokenfactory)
RADEON_API_KEY=
RADEON_BASE_URL=https://developer.amd.com.cn/radeon/api/v1

# Models: primary + fallback chain (checked at startup via GET /v1/models)
PRIMARY_MODEL=Gemma-4-31B-IT
FALLBACK_MODELS=MiMo-V2.6-Flash,GLM-5.3-Flash,DeepSeek-V4.1-Flash

# Optional thermal printer (ESC/POS over LAN). Leave empty to use the on-screen simulator.
PRINTER_HOST=
PRINTER_PORT=9100
# Local installs only: enables the "Printer settings" dialog (IP, port, test print; local-network targets only).
# Keep 0 on the hosted demo.
ALLOW_PRINTER_SETUP=0

# Speech-to-text: faster-whisper in this container (model baked into the image at build time)
WHISPER_MODEL=base.en

# Replay of recorded model answers: off | fallback (only if every model fails) | always (offline demo)
REPLAY_MODE=fallback

# Public HTTPS address (used for the QR code). DOMAIN enables the Caddy HTTPS proxy: docker compose --profile https up -d
PUBLIC_URL=
DOMAIN=

# Demo clock for "last 30 days" and recurring faults (ISO date). Empty = time of the latest entry in
# data/ticket_history.json (2026-10-09). Never the real date, so the demo history does not age out.
DEMO_NOW=

# Print "(replay)" on the receipt when a recorded run is used (the UI always says so)
DEMO_MODE=0

# Host port for docker compose on your machine (default 8000). Hosting platforms set PORT themselves.
HOST_PORT=

# Requests per minute per client IP (the team key allows ~20/min in total)
RATE_LIMIT_PER_MIN=10
